{
  "name": "cortex",
  "private": true,
  "version": "0.0.1",
  "description": "Synthetic focus-group agents on 0G + AXL + ENS",
  "scripts": {
    "smoke:storage": "pnpm -F @cortex/core smoke:storage",
    "smoke:compute": "pnpm -F @cortex/core smoke:compute",
    "deploy:contracts": "pnpm --filter @cortex/contracts deploy:testnet",
    "spawn:axl": "bash infra/axl/spawn.sh",
    "session:run": "pnpm -F @cortex/moderator start",
    "protocol-twins": "pnpm -F @cortex/kit protocol-twins",
    "agents:build": "pnpm -F @cortex/kit build-agents",
    "e2e:kit": "bash e2e-kit/quickstart.sh",
    "ui": "pnpm -F @cortex/ui dev",
    "cortex:init": "pnpm -F @cortex/cli dev init",
    "cortex:discover": "pnpm -F @cortex/cli dev discover",
    "cortex:project": "pnpm -F @cortex/cli dev project",
    "twins:start": "pnpm -F @cortex/protocol-twins start",
    "demo:dev-session": "pnpm tsx demo/05-dev-session.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
